{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScanDesk",
  "version": "1.0.0",
  "identifier": "com.scandesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScanDesk \u2014 Private QR & Barcode Suite",
        "width": 1100,
        "height": 780,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' blob: data:; img-src 'self' blob: data: https:; media-src 'self' blob: data: mediastream:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "all"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Private, offline-first QR and barcode scanner & generator suite.",
    "longDescription": "ScanDesk is a fast, zero-telemetry QR code and 1D/2D barcode scanning and generation platform.",
    "category": "Utility",
    "copyright": "Copyright 2026 Shayan Shah"
  }
}